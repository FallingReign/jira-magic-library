#!/bin/sh
#
# Pre-commit hook: blocks commits that contain PII.
#
# Install: npm run install:hooks
#

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo "${BLUE}🔍 Running PII detection...${NC}\n"

node scripts/pii-check.js
PII_EXIT_CODE=$?

if [ $PII_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "${RED}❌ COMMIT BLOCKED: PII detected in staged files${NC}"
  echo "${RED}   Remove the PII or add false positives to .pii-config.json whitelist${NC}"
  echo ""
  exit 1
fi

echo "${GREEN}✅ No PII detected${NC}\n"
exit 0
